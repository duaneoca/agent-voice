#!/usr/bin/env bash
# Control CLI for the agentvoice daemon, in the shape Omarchy expects: the bar
# widget and Hyprland binds both shell out to this rather than knowing about
# systemd or signals.
#
#   agentvoice start|stop|toggle   the service, i.e. the switch in the panel
#   agentvoice mic                 release or re-engage the mic, service left up
#   agentvoice interrupt           stop the reply in progress, keep listening
#   agentvoice talk                push-to-talk pressed: listen now, or, if it
#                                  is mid-reply, stop it
#   agentvoice talk-end            push-to-talk released: that was the turn
#   agentvoice status              JSON, for scripts and the bar
#   agentvoice is-active           yes|no, for a keybind that has to branch
#   agentvoice calibrate           can this room support barge-in?
#   agentvoice monitor             live wake-word scores, for tuning
#   agentvoice permit <id> allow|deny   answer a pending permission request
#   agentvoice pending             the request waiting for an answer, as JSON
set -euo pipefail

UNIT=agentvoice.service
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agentvoice"
STATE="$RUNDIR/state"
PIDFILE="$RUNDIR/pid"

active() { systemctl --user is-active --quiet "$UNIT"; }

# What the daemon is doing right now; "off" when it is not running.
vstate() {
  if [[ -r $STATE ]] && active; then
    sed -n 's/.*"state"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$STATE"
  else
    echo off
  fi
}

# SIGUSR1 and SIGUSR2 both default to terminating the process. Two ways that
# bites: a daemon installed before the interrupt existed does not catch
# SIGUSR2, and a pidfile left behind by a crash names a pid the kernel has
# since given to something else entirely. So nothing is signalled unless its
# caught-signal mask says it is listening. SigCgt is that mask, and a signal
# n sits at bit n-1.
handles() {
  local mask signo="$2"
  mask=$(awk '/^SigCgt:/{print $2}' "/proc/$1/status" 2>/dev/null) || return 1
  [[ -n $mask ]] || return 1
  (( (0x$mask >> (signo - 1)) & 1 ))
}

# The pid to signal, or nothing. Written by the daemon and removed on the way
# out -- but not on a kill -9, hence the check above.
daemon_pid() {
  local pid
  [[ -r $PIDFILE ]] || return 1
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ -d /proc/$pid ]] || return 1
  printf '%s' "$pid"
}

# One-shot command to the run loop. Renamed into place so the daemon cannot
# read a half-written file.
send_command() {
  mkdir -p "$RUNDIR"
  printf '%s' "$1" > "$RUNDIR/command.tmp" && mv -f "$RUNDIR/command.tmp" "$RUNDIR/command"
}

case "${1:-status}" in
  start)
    active || systemctl --user start "$UNIT"
    ;;
  stop)
    systemctl --user stop "$UNIT" 2>/dev/null || true
    # The unit clears this on the way out, but a hard kill would not.
    printf '{"state":"off"}' > "$STATE" 2>/dev/null || true
    ;;
  toggle)
    if active; then exec "$0" stop; else exec "$0" start; fi
    ;;
  mic)
    # Via systemd where systemd is running it, because the unit knows which
    # process is actually ours and a pidfile only claims to.
    if active; then
      systemctl --user kill -s USR1 "$UNIT"
    elif pid=$(daemon_pid) && handles "$pid" 10; then
      kill -USR1 "$pid"
    else
      echo "daemon not running" >&2
      exit 1
    fi
    ;;
  interrupt)
    # Cut the reply short. A no-op when the daemon is idle, so this is safe to
    # bind to a key you might hit at any time.
    if pid=$(daemon_pid) && handles "$pid" 12; then
      kill -USR2 "$pid"
    elif [[ -n ${pid:-} ]]; then
      echo "this daemon predates the interrupt; restart it:" >&2
      echo "  agentvoice stop && agentvoice start" >&2
      exit 1
    else
      echo "daemon not running" >&2
      exit 1
    fi
    ;;
  talk)
    # The push-to-talk key going down. Mid-reply that means "stop talking";
    # otherwise it means "listen to me now", skipping the wake word.
    case "$(vstate)" in
      off)                 echo "daemon not running" >&2; exit 1 ;;
      thinking|speaking)   exec "$0" interrupt ;;
      *)                   send_command talk ;;
    esac
    ;;
  talk-end)
    # The key coming back up ends the turn. Ignored by the daemon unless a
    # push-to-talk capture is actually open.
    active && send_command talk-end
    ;;
  permit)
    # Answer a pending permission request. The overlay calls this; so can you.
    #   agentvoice permit <id> allow|deny
    id="${2:-}"; verdict="${3:-deny}"
    # The id is a filename, so it is checked rather than trusted: the hook
    # makes it from twelve hex characters, and `../../x` would otherwise write
    # a .response anywhere it liked.
    if [[ ! $id =~ ^[0-9a-f]{12}$ ]]; then
      echo "usage: agentvoice permit <id> allow|deny   (id is 12 hex characters)" >&2
      exit 2
    fi
    D="$RUNDIR/permissions"
    if [[ $verdict == allow ]]; then
      printf '{"allow":true}' > "$D/$id.response"
    else
      printf '{"allow":false,"reason":"denied at the desktop"}' > "$D/$id.response"
    fi
    ;;
  pending)
    # A permission request waiting for an answer, as JSON.
    #   agentvoice pending <id>   that exact one, so the overlay answers the
    #                             question it was summoned about
    #   agentvoice pending        the newest, for a person at a terminal
    D="$RUNDIR/permissions"
    want="${2:-}"
    if [[ -n $want ]]; then
      if [[ ! $want =~ ^[0-9a-f]{12}$ ]]; then echo '{}'; exit 0; fi
      [[ -r "$D/$want.request" ]] && cat "$D/$want.request" || echo '{}'
    else
      # `|| true`, because of `set -euo pipefail`: with no permissions
      # directory `ls` exits 2, pipefail carries that out of the pipeline, and
      # a failing command substitution in an assignment ends the script -- so
      # "nothing is pending" printed nothing at all and exited 2. The overlay
      # survived it by failing to parse the empty output, which is not the
      # same as being told there is nothing. Same shape as the jq-exits-2 bug
      # in install.sh.
      f=$(ls -t "$D"/*.request 2>/dev/null | head -1) || true
      if [[ -n ${f:-} && -r ${f:-} ]]; then cat "$f"; else echo '{}'; fi
    fi
    ;;
  calibrate)
    # Whether the user can be heard over the speaker is a property of the
    # room, not of the code, so it is measured rather than assumed.
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    # The path goes through the environment, not through the source: a repo
    # checked out somewhere with an apostrophe in the name would otherwise
    # end the string literal and break the program.
    AGENTVOICE_DAEMON_DIR="$REPO/daemon" exec "$PY" -c \
      'import os, sys; sys.path.insert(0, os.environ["AGENTVOICE_DAEMON_DIR"]); import barge; sys.exit(barge.calibrate())'
    ;;
  monitor)
    # Live wake-word scores. Safe to run alongside the daemon: PipeWire allows
    # several readers on one microphone.
    shift
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY="$REPO/bench/.venv/bin/python"
    exec "$PY" "$REPO/daemon/monitor.py" "$@"
    ;;
  status)
    if [[ -r $STATE ]] && active; then cat "$STATE"; else echo '{"state":"off"}'; fi
    ;;
  is-active)
    active && echo yes || echo no
    ;;
  *)
    echo "usage: agentvoice [start|stop|toggle|mic|talk|talk-end|interrupt|monitor|calibrate|permit|pending|status|is-active]" >&2
    exit 2
    ;;
esac
