#!/usr/bin/env bash
# Control CLI for the agentvoice daemon, in the shape Omarchy expects: the bar
# widget and Hyprland binds both shell out to this rather than knowing about
# systemd or signals.
#
#   agentvoice start|stop|toggle   the service, i.e. the switch in the panel
#   agentvoice mic                 release or re-engage the mic, service left up
#   agentvoice status              JSON, for scripts and the bar
#   agentvoice monitor             live wake-word scores, for calibration
#   agentvoice permit <id> allow|deny   answer a pending permission request
#   agentvoice pending             the request waiting for an answer, as JSON
set -euo pipefail

UNIT=agentvoice.service
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agentvoice"
STATE="$RUNDIR/state"
PIDFILE="$RUNDIR/pid"

active() { systemctl --user is-active --quiet "$UNIT"; }

case "${1:-status}" in
  start)
    active || systemctl --user start "$UNIT"
    ;;
  stop)
    systemctl --user stop "$UNIT" 2>/dev/null || true
    # The unit clears this on the way out, but a hard kill would not.
    printf '{"state":"off"}' > "$STATE" 2>/dev/null || true
    ;;
  toggle)
    if active; then exec "$0" stop; else exec "$0" start; fi
    ;;
  mic)
    if [[ -r $PIDFILE ]]; then
      kill -USR1 "$(cat "$PIDFILE")"
    else
      echo "daemon not running" >&2
      exit 1
    fi
    ;;
  permit)
    # Answer a pending permission request. The overlay calls this; so can you.
    #   agentvoice permit <id> allow|deny
    id="${2:-}"; verdict="${3:-deny}"
    [[ -n $id ]] || { echo "usage: agentvoice permit <id> allow|deny" >&2; exit 2; }
    D="$RUNDIR/permissions"
    if [[ $verdict == allow ]]; then
      printf '{"allow":true}' > "$D/$id.response"
    else
      printf '{"allow":false,"reason":"denied at the desktop"}' > "$D/$id.response"
    fi
    ;;
  pending)
    # Any permission request waiting for an answer, as JSON.
    D="$RUNDIR/permissions"
    f=$(ls -t "$D"/*.request 2>/dev/null | head -1)
    [[ -n ${f:-} ]] && cat "$f" || echo '{}'
    ;;
  monitor)
    # Live wake-word scores. Safe to run alongside the daemon: PipeWire allows
    # several readers on one microphone.
    shift
    REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
    PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
    [[ -x $PY ]] || PY="$REPO/bench/.venv/bin/python"
    exec "$PY" "$REPO/daemon/monitor.py" "$@"
    ;;
  status)
    if [[ -r $STATE ]] && active; then cat "$STATE"; else echo '{"state":"off"}'; fi
    ;;
  is-active)
    active && echo yes || echo no
    ;;
  *)
    echo "usage: agentvoice [start|stop|toggle|mic|monitor|permit|pending|status|is-active]" >&2
    exit 2
    ;;
esac
