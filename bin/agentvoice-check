#!/usr/bin/env bash
# Consistency checks that do not need a running desktop.
#
# The first one exists because a setting was declared in manifest.json, wired
# through the daemon, and never drawn in the overlay -- so it worked from the
# CLI and was invisible in the UI. Nothing caught that but a user noticing.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fail=0

say() { printf '  %-46s %s\n' "$1" "$2"; }

# Resolved once, and used for the syntax check as well as the tests. Syntax is
# version-specific: nesting the same quote inside an f-string is legal from
# 3.12 and a SyntaxError before it, so checking with whatever `python3` happens
# to be says nothing about the range this project claims to support. CI caught
# one of those; this machine could not, because its venv is newer.
#
# Chosen by what it can *run*, not by what exists: the runtime venv is the
# daemon's, and install.sh deliberately puts only requirements.txt in it, so
# the moment anyone reinstalls, the first existing interpreter is one with no
# pytest -- and the suite skipped while the script still exited 0. The gate
# for the whole project was one `./install.sh` away from being silent.
#
# AGENTVOICE_PYTHON is an answer, not a first guess: if someone names an
# interpreter, searching past it would run the checks against a different one
# than they asked for and report a pass about the wrong thing.
if [[ -n ${AGENTVOICE_PYTHON:-} ]]; then
  PY="$AGENTVOICE_PYTHON"
else
  for cand in "$HOME/.local/share/agentvoice/venv/bin/python" \
              "$ROOT/bench/.venv/bin/python" "$(command -v python3)"; do
    [[ -x $cand ]] || continue
    [[ -n ${PY:-} ]] || PY="$cand"        # the fallback: first one that runs
    if "$cand" -c "import pytest" 2>/dev/null; then PY="$cand"; break; fi
  done
  PY="${PY:-}"
fi

# Several checks below iterate `git ls-files`. Outside a repository that is
# empty, and every one of them would pass having examined nothing -- the same
# shape of false green as a skipped test suite.
if ! git -C "$ROOT" ls-files --error-unmatch manifest.json >/dev/null 2>&1; then
  say "repository" "FAIL: not a git checkout, so the file checks would be vacuous"
  exit 1
fi

# 1. every schema key has a control on the settings page
#
# Settings.qml only. It used to read Panel.qml as well, which made the check
# weaker than it looks: the panel carried `setting("leadInMs", ...)` lines
# that nothing drew, so the check stayed green for keys whose control had
# been deleted from the settings page. The panel is a readout; the settings
# page is where a key is edited, and that is what this is checking for.
out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, re, sys
root = pathlib.Path(sys.argv[1])
declared = {k["key"] for k in json.loads((root/"manifest.json").read_text())["barWidget"]["schema"]}
qml = (root/"Settings.qml").read_text()
missing = sorted(k for k in declared if not re.search(r'["\']' + re.escape(k) + r'["\']', qml))
print(" ".join(missing))
PY
)
if [[ -n ${out// } ]]; then say "settings declared but never drawn" "FAIL: $out"; fail=1
else say "every schema key is drawn in the UI" "ok"; fi

# 2. every schema key has a default the daemon knows
out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
declared = {k["key"] for k in json.loads((root/"manifest.json").read_text())["barWidget"]["schema"]}
# Imported rather than scraped. The previous version split the source on the
# first "}" after DEFAULTS, so the day a default was an empty dict the block
# ended early and every key after it silently looked undefaulted.
sys.path.insert(0, str(root / "daemon"))
from runtime import DEFAULTS
print(" ".join(sorted(declared - set(DEFAULTS))))
PY
)
if [[ -n ${out// } ]]; then say "settings with no daemon default" "FAIL: $out"; fail=1
else say "every schema key has a daemon default" "ok"; fi

# 3. python files parse
bad=""
for f in $(git -C "$ROOT" ls-files '*.py'); do
  "$PY" -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$ROOT/$f" 2>/dev/null || bad="$bad $f"
done
if [[ -n ${bad// } ]]; then say "python syntax" "FAIL:$bad"; fail=1; else say "python syntax" "ok"; fi

# 4. shell scripts parse
bad=""
for f in $(git -C "$ROOT" ls-files 'bin/*' 'install.sh' 'bench/*.sh'); do
  bash -n "$ROOT/$f" 2>/dev/null || bad="$bad $f"
done
if [[ -n ${bad// } ]]; then say "shell syntax" "FAIL:$bad"; fail=1; else say "shell syntax" "ok"; fi

# 5. nothing that would stop `omarchy plugin add` installing this. It refuses
# symlinks inside a plugin folder, and the manifest is the first thing the
# shell reads -- an entry point naming a file that is not there installs a
# widget that silently does nothing.
out=$(git -C "$ROOT" ls-files -s | awk '$1 == "120000" {print $4}')
if [[ -n ${out// } ]]; then say "tracked symlinks (plugin add refuses them)" "FAIL: $out"; fail=1
else say "no tracked symlinks" "ok"; fi

out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
m = json.loads((root / "manifest.json").read_text())
missing = [k for k in ("id", "name", "version", "license", "schemaVersion",
                       "kinds", "entryPoints") if not m.get(k)]
for kind, rel in (m.get("entryPoints") or {}).items():
    if not (root / rel).exists():
        missing.append(f"{kind}->{rel}")
print(" ".join(missing))
PY
)
if [[ -n ${out// } ]]; then say "manifest is installable" "FAIL: $out"; fail=1
else say "manifest is installable" "ok"; fi

# 6. no test imports a heavy dependency before it can be skipped. The runner
# installs pytest and nothing else -- that is what keeps it at fifteen
# seconds -- so `import numpy` at the top of a test file passes here and
# fails there. Three times in one week, each found by CI rather than by this.
out=$("$PY" - "$ROOT" <<'PY'
import ast, pathlib, sys
# Only the wheels the runner does not install. The project's own modules are
# fine: they are stdlib-only at import time, which is why the suite runs at
# all. A test needing one of these must reach it through pytest.importorskip.
heavy = {"numpy", "onnxruntime", "sounddevice", "torch", "openwakeword",
         "vosk", "piper", "scipy", "sklearn", "faster_whisper", "soundfile",
         "joblib", "barge", "verifier", "monitor"}
bad = []
for path in sorted((pathlib.Path(sys.argv[1]) / "tests").glob("test_*.py")):
    for node in ast.parse(path.read_text()).body:      # module level only
        names = []
        if isinstance(node, ast.Import):
            names = [a.name.split(".")[0] for a in node.names]
        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
            names = [node.module.split(".")[0]]
        for n in names:
            if n in heavy:
                bad.append(f"{path.name}:{node.lineno} {n}")
print(" ".join(bad))
PY
)
if [[ -n ${out// } ]]; then
  say "tests import heavy deps at module level" "FAIL: $out"
  fail=1
else
  say "no test imports a heavy dep too early" "ok"
fi

# 7. no QML command nests a `bash -c` inside the floating-terminal launcher.
# That launcher already does `cmd="$*"` and re-wraps the result in its own
# `bash -c`, so a second one turns the first following word into $0 instead of
# an argument. The Remove button's `--uninstall` landed in $0 and vanished;
# what ran was a plain install, which then deleted its own source directory.
out=$(python3 - "$ROOT" <<'QQ'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])
bad = []
for name in ("Settings.qml", "Panel.qml"):
    lines = (root / name).read_text().splitlines()
    for i, line in enumerate(lines):
        if "omarchy-launch-floating-terminal-with-presentation" not in line:
            continue
        window = " ".join(lines[i:i + 6])
        if re.search(r'"bash"\s*,\s*"-c"', window):
            bad.append(f"{name}:{i + 1}")
print(" ".join(bad))
QQ
)
if [[ -n ${out// } ]]; then say "nested bash -c eats the launcher's args" "FAIL: $out"; fail=1
else say "no nested bash -c in a launcher command" "ok"; fi

# 8. no comment directly after a line-continuation backslash. `bash -n` accepts
# it, and what it means is that the continuation joins to the comment: the
# command loses everything that was meant to follow, and the next line runs as
# a statement of its own. Found the hard way -- `gum spin --title X -- \` with a
# comment under it printed gum's usage on every call while the command it was
# supposed to wrap ran unwrapped, so the work succeeded and the error was real.
out=$(python3 - "$ROOT" <<'QQ'
import pathlib, subprocess, sys
root = pathlib.Path(sys.argv[1])
bad = []
files = subprocess.run(["git", "-C", str(root), "ls-files", "bin/*", "install.sh",
                        "bench/*.sh"], capture_output=True, text=True).stdout.split()
for rel in files:
    lines = (root / rel).read_text().splitlines()
    for i, line in enumerate(lines[:-1]):
        if line.rstrip().endswith("\\") and lines[i + 1].lstrip().startswith("#"):
            bad.append(f"{rel}:{i + 2}")
print(" ".join(bad))
QQ
)
if [[ -n ${out// } ]]; then say "comment after a line continuation" "FAIL: $out"; fail=1
else say "no comment orphaning a continued line" "ok"; fi

# 9. every model download is pinned to a revision and checked against a hash,
# in all three scripts that fetch one. Three things can go wrong here and all
# of them are quiet: a URL drifting between the scripts is a 404 inside a gum
# spinner; a voice the settings page offers but the lock does not name cannot
# be installed at all; and a fetch that checks nothing is a model of unknown
# provenance loaded by the daemon.
out=$(python3 - "$ROOT" <<'QQ'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])
bad = []
lock = (root / "models.lock")
if not lock.is_file():
    print("models.lock is missing, so nothing is pinned or verified")
    raise SystemExit
text = lock.read_text()

rev = re.search(r"^revision piper ([0-9a-f]{40})$", text, re.M)
if not rev:
    bad.append("models.lock has no 40-character piper revision")

# All three scripts must build the URL from the lock rather than from a
# branch name, and must verify what arrives.
sources = {
    "install.sh": root / "install.sh",
    "bench/setup.sh": root / "bench" / "setup.sh",
    "bin/agentvoice-train-verifier": root / "bin" / "agentvoice-train-verifier",
}
for name, path in sources.items():
    body = path.read_text()
    if "resolve/main" in body:
        bad.append(f"{name} still fetches from resolve/main")
    if 'revision" && $2=="piper"' not in body:
        bad.append(f"{name} does not read the revision from models.lock")
    if "sha256sum" not in body:
        bad.append(f"{name} does not check a hash")

# Every voice the settings page offers has to be installable, which now means
# it has to be in the lock.
hashed = set(re.findall(r"^sha256 (\S+)", text, re.M))
offered = re.findall(r'value: "([a-z_]+-(?:x_low|low|medium|high))"',
                     (root / "Settings.qml").read_text())
for voice in sorted(set(offered)):
    for suffix in ("", ".json"):
        wanted = f"en_US-{voice}.onnx{suffix}"
        if wanted not in hashed:
            bad.append(f"{voice} is offered in the UI but {wanted} is not in "
                       f"models.lock, so choosing it cannot install it")

# And every speaker the trainer fetches for contrast.
train = (root / "bin" / "agentvoice-train-verifier").read_text()
speakers = re.search(r"OTHER_SPEAKERS=\(([^)]*)\)", train)
for voice in (speakers.group(1).split() if speakers else []):
    if f"en_US-{voice}.onnx" not in hashed:
        bad.append(f"the trainer fetches {voice}, which is not in models.lock")

print("; ".join(bad))
QQ
)
if [[ -n ${out// } ]]; then say "model pinning" "FAIL: $out"; fail=1
else say "every model download is pinned and hashed" "ok"; fi

# 10. a numeric setting declares its range the way Omarchy spells it. `min`,
# `max` and `step` -- not `minimum`/`maximum`, which is what QML's own slider
# calls them and what two settings here were written with, and not a range
# with no step. Omarchy reads the schema to draw the control, so the wrong
# spelling is a control with no bounds and a slider that moves by one.
out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
schema = json.loads((root/"manifest.json").read_text())["barWidget"]["schema"]
bad = []
for entry in schema:
    wrong = sorted(k for k in entry if k in ("minimum", "maximum"))
    if wrong:
        bad.append(f"{entry['key']}: {'/'.join(wrong)} should be min/max")
        continue
    ranged = [k for k in ("min", "max", "step") if k in entry]
    if ranged and len(ranged) != 3:
        missing = [k for k in ("min", "max", "step") if k not in entry]
        bad.append(f"{entry['key']}: has {'/'.join(ranged)}, missing "
                   f"{'/'.join(missing)}")
print("; ".join(bad))
PY
)
if [[ -n ${out// } ]]; then say "schema ranges" "FAIL: $out"; fail=1
else say "every numeric setting declares min/max/step" "ok"; fi

# 10b. every state the daemon can publish is drawn by the bar widget. A state
# with no case falls through to the default and reads "STARTING" forever --
# which is how the locked state would have shipped invisible, and the same
# shape as the settings that were declared and never drawn.
out=$(python3 - "$ROOT" <<'QQ'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])
daemon = (root / "daemon" / "wake_listen.py").read_text()
m = re.search(r"^STATES = \(([^)]*)\)", daemon, re.M)
if not m:
    print("daemon/wake_listen.py no longer declares STATES")
    raise SystemExit
states = re.findall(r'"([a-z]+)"', m.group(1))
panel = (root / "Panel.qml").read_text()
missing = []
for block in ("icon", "stateLabel"):
    start = panel.index(f"readonly property string {block}:")
    body = panel[start:panel.index("\n  }", start)]
    for state in states:
        # "off" is drawn by the !serviceActive branch rather than by name.
        if state == "off":
            continue
        if f'vState === "{state}"' not in body:
            missing.append(f"{state} has no {block}")
print("; ".join(missing))
QQ
)
if [[ -n ${out// } ]]; then say "a published state the panel never draws" "FAIL: $out"; fail=1
else say "every daemon state is drawn by the widget" "ok"; fi

# 11. the QML references properties that exist. Nothing here runs the overlay,
# so this is the only automated check the interface gets -- and the interface
# is where this project's bugs have landed: a KnobRow given `suffix` when it
# takes `unit`, a `voiceOptions` renamed without its callers, a Timer nested
# in a FileView. Each was found by reading the shell log after a user noticed.
# qmllint's other categories are noisy against Quickshell's singletons
# (170 unqualified accesses, all of them fine), so only missing-property is
# gated. Verified by reintroducing the `suffix` bug: it is caught.
QMLLINT="${AGENTVOICE_QMLLINT:-/usr/lib/qt6/bin/qmllint}"
# Omarchy's own QML modules, when this runs on a machine that has them. They
# are not needed for the check to bite: `unit` versus `suffix` is a property of
# a file in this repository, which resolves either way. Verified by removing
# the path and reintroducing that bug -- still caught, and still zero against
# clean sources, so CI does not need Omarchy installed to run this honestly.
QMLARGS=()
[[ -d /usr/share/omarchy/shell ]] && QMLARGS=(-I /usr/share/omarchy/shell)

if [[ -x $QMLLINT ]]; then
  out=""
  for f in $(git -C "$ROOT" ls-files '*.qml'); do
    while IFS= read -r line; do
      out="$out\n    $line"
    done < <("$QMLLINT" "${QMLARGS[@]+"${QMLARGS[@]}"}" "$ROOT/$f" 2>&1 |
             grep "\[missing-property\]")
  done
  if [[ -n ${out//[$'\n' ]} ]]; then
    say "QML references a property that does not exist" "FAIL"
    printf '%b\n' "$out"
    fail=1
  else
    say "every QML property reference resolves" "ok"
  fi
elif [[ -n ${AGENTVOICE_STRICT:-}${CI:-} ]]; then
  # Same rule as the tests: a check that silently did not run is not a pass.
  # CI installs qt6-declarative for this.
  say "qmllint" "FAIL: not found at $QMLLINT, and this run must not skip it"
  fail=1
else
  say "qmllint not installed, skipping QML check" "--"
fi

# 12. the real installer, against a machine that is not this one. Opt-in: it
# runs four installs and downloads ~100MB each, so it belongs before a release
# rather than before every commit. Every install bug so far hid behind
# something this machine already had.
if [[ -n ${AGENTVOICE_BOX:-} ]]; then
  if out=$("$ROOT/bench/install-in-a-box.sh" 2>&1); then
    say "installer in a box" "$(tail -1 <<<"$out" | sed 's/^ *//')"
  else
    say "installer in a box" "FAIL"
    echo "$out" | sed 's/^/    /'
    fail=1
  fi
else
  say "installer-in-a-box not run (AGENTVOICE_BOX=1)" "--"
fi

# 13. the behavioural tests, when pytest is available
if [[ -x $PY ]] && "$PY" -c "import pytest" 2>/dev/null; then
  if out=$("$PY" -m pytest "$ROOT/tests" -q 2>&1); then
    summary="$(tail -1 <<<"$out")"
    # On a runner that installed the whole stack, a skip means a test that
    # was meant to run did not. Opt-in rather than part of AGENTVOICE_STRICT,
    # because the light CI job installs pytest alone and skips the numeric
    # tests on purpose -- so "no skips" is only true of the full job, and a
    # check that is only sometimes true is not a check.
    if [[ -n ${AGENTVOICE_NO_SKIPS:-} && $summary == *skipped* ]]; then
      say "tests" "FAIL: something skipped on a runner with the full stack"
      echo "$out" | grep -i 'skipped' | tail -10 | sed 's/^/    /'
      fail=1
    else
      say "tests" "$summary"
    fi
  else
    say "tests" "FAIL"
    echo "$out" | tail -20 | sed 's/^/    /'
    fail=1
  fi
elif [[ -n ${AGENTVOICE_STRICT:-}${CI:-}${AGENTVOICE_NO_SKIPS:-} ]]; then
  # A skip is a green run that proved nothing. Acceptable on a laptop with no
  # dev venv; never acceptable on a machine whose whole job is to check.
  #
  # NO_SKIPS belongs here too: it used to be read only *inside* the branch
  # where pytest was found, so the one flag that means "nothing may quietly
  # not run" exited 0 with the entire suite unrun.
  say "tests" "FAIL: pytest missing, and this run must not skip it"
  fail=1
else
  say "tests" "skipped (pip install -r requirements-dev.txt)"
fi

exit $fail
