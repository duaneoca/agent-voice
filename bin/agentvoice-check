#!/usr/bin/env bash
# Consistency checks that do not need a running desktop.
#
# The first one exists because a setting was declared in manifest.json, wired
# through the daemon, and never drawn in the overlay -- so it worked from the
# CLI and was invisible in the UI. Nothing caught that but a user noticing.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fail=0

say() { printf '  %-46s %s\n' "$1" "$2"; }

# Resolved once, and used for the syntax check as well as the tests. Syntax is
# version-specific: nesting the same quote inside an f-string is legal from
# 3.12 and a SyntaxError before it, so checking with whatever `python3` happens
# to be says nothing about the range this project claims to support. CI caught
# one of those; this machine could not, because its venv is newer.
PY="${AGENTVOICE_PYTHON:-$HOME/.local/share/agentvoice/venv/bin/python}"
[[ -x $PY ]] || PY="$ROOT/bench/.venv/bin/python"
[[ -x $PY ]] || PY="$(command -v python3)"

# Several checks below iterate `git ls-files`. Outside a repository that is
# empty, and every one of them would pass having examined nothing -- the same
# shape of false green as a skipped test suite.
if ! git -C "$ROOT" ls-files --error-unmatch manifest.json >/dev/null 2>&1; then
  say "repository" "FAIL: not a git checkout, so the file checks would be vacuous"
  exit 1
fi

# 1. every schema key is rendered somewhere in the overlay
out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, re, sys
root = pathlib.Path(sys.argv[1])
declared = {k["key"] for k in json.loads((root/"manifest.json").read_text())["barWidget"]["schema"]}
qml = (root/"Settings.qml").read_text() + (root/"Panel.qml").read_text()
missing = sorted(k for k in declared if not re.search(r'["\']' + re.escape(k) + r'["\']', qml))
print(" ".join(missing))
PY
)
if [[ -n ${out// } ]]; then say "settings declared but never drawn" "FAIL: $out"; fail=1
else say "every schema key is drawn in the UI" "ok"; fi

# 2. every schema key has a default the daemon knows
out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
declared = {k["key"] for k in json.loads((root/"manifest.json").read_text())["barWidget"]["schema"]}
# Imported rather than scraped. The previous version split the source on the
# first "}" after DEFAULTS, so the day a default was an empty dict the block
# ended early and every key after it silently looked undefaulted.
sys.path.insert(0, str(root / "daemon"))
from runtime import DEFAULTS
print(" ".join(sorted(declared - set(DEFAULTS))))
PY
)
if [[ -n ${out// } ]]; then say "settings with no daemon default" "FAIL: $out"; fail=1
else say "every schema key has a daemon default" "ok"; fi

# 3. python files parse
bad=""
for f in $(git -C "$ROOT" ls-files '*.py'); do
  "$PY" -c "import ast,sys;ast.parse(open(sys.argv[1]).read())" "$ROOT/$f" 2>/dev/null || bad="$bad $f"
done
if [[ -n ${bad// } ]]; then say "python syntax" "FAIL:$bad"; fail=1; else say "python syntax" "ok"; fi

# 4. shell scripts parse
bad=""
for f in $(git -C "$ROOT" ls-files 'bin/*' 'install.sh' 'bench/*.sh'); do
  bash -n "$ROOT/$f" 2>/dev/null || bad="$bad $f"
done
if [[ -n ${bad// } ]]; then say "shell syntax" "FAIL:$bad"; fail=1; else say "shell syntax" "ok"; fi

# 5. nothing that would stop `omarchy plugin add` installing this. It refuses
# symlinks inside a plugin folder, and the manifest is the first thing the
# shell reads -- an entry point naming a file that is not there installs a
# widget that silently does nothing.
out=$(git -C "$ROOT" ls-files -s | awk '$1 == "120000" {print $4}')
if [[ -n ${out// } ]]; then say "tracked symlinks (plugin add refuses them)" "FAIL: $out"; fail=1
else say "no tracked symlinks" "ok"; fi

out=$(python3 - "$ROOT" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
m = json.loads((root / "manifest.json").read_text())
missing = [k for k in ("id", "name", "version", "license", "schemaVersion",
                       "kinds", "entryPoints") if not m.get(k)]
for kind, rel in (m.get("entryPoints") or {}).items():
    if not (root / rel).exists():
        missing.append(f"{kind}->{rel}")
print(" ".join(missing))
PY
)
if [[ -n ${out// } ]]; then say "manifest is installable" "FAIL: $out"; fail=1
else say "manifest is installable" "ok"; fi

# 6. the behavioural tests, when pytest is available
if [[ -x $PY ]] && "$PY" -c "import pytest" 2>/dev/null; then
  if out=$("$PY" -m pytest "$ROOT/tests" -q 2>&1); then
    say "tests" "$(tail -1 <<<"$out")"
  else
    say "tests" "FAIL"
    echo "$out" | tail -20 | sed 's/^/    /'
    fail=1
  fi
elif [[ -n ${AGENTVOICE_STRICT:-}${CI:-} ]]; then
  # A skip is a green run that proved nothing. Acceptable on a laptop with no
  # dev venv; never acceptable on a machine whose whole job is to check.
  say "tests" "FAIL: pytest missing, and this is a strict run"
  fail=1
else
  say "tests" "skipped (pip install -r requirements-dev.txt)"
fi

exit $fail
