#!/bin/bash
# Train a personal wake-word verifier.
#
# Designed to run inside omarchy-launch-floating-terminal-with-presentation,
# which wraps it in the Omarchy logo/done screens and suppresses the "done"
# screen on exit 130. So every cancel path here exits 130 deliberately.

set -uo pipefail

CLIPS=25
CLIP_SECONDS=2.0
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/agentvoice"
WORK="$STATE/verifier-training"
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Omarchy floats this terminal at 875x600 -- roughly 90 columns by 30 rows --
# so the copy has to fit a small box in both directions.
#
# `gum style --border` without an explicit --width measures the widest content
# line INCLUDING its ANSI escapes, so nesting a `gum format` block inside one
# produced a 298-column box: it wrapped, and the border's verticals ended up
# scattered through the paragraph. Every bordered block below therefore passes
# --width, and prose is wrapped here rather than by gum.
COLS=$(tput cols 2>/dev/null || echo 80)
[[ -n ${COLS//[!0-9]/} ]] || COLS=80
W=$(( COLS - 6 ))
(( W > 64 )) && W=64
(( W < 36 )) && W=36
# Prose inside a bordered block has to fit the INNER width: the box is $W
# wide, minus two border columns and four of padding. Folding to $W and
# letting gum re-wrap the overflow is what orphans single words.
INNER=$(( W - 6 ))
wrap()  { fold -s -w "$INNER"; }
wrapw() { fold -s -w "$W"; }

# The whole flow is about fifty rows of output in a thirty row window -- the
# presentation wrapper's logo alone is thirteen. Rather than let it scroll,
# each phase clears and owns the screen.
screen() { clear 2>/dev/null || tput clear 2>/dev/null || true; }

# `gum spin` draws its animation on stdout, so capturing it with $( ) swallows
# the spinner and leaves a bare cursor for however long the work takes -- nine
# seconds for the voice synthesis alone. Output goes to a file instead, and the
# spinner keeps the terminal.
# stderr has to go somewhere too. train_custom_verifier draws tqdm progress
# bars -- several kilobytes of carriage returns and block characters -- and
# they land on the same line the spinner is animating, which is what produced
# the garbled escape sequences around the title. It is captured rather than
# discarded so a real failure can still be shown.
SPIN_ERR=""
spin() {  # spin <title> <outfile> -- <cmd...>
  local title="$1" out="$2"
  shift 3
  SPIN_ERR="$(mktemp)"
  tty_flush
  echo_off
  gum spin --title "$title" -- \
    bash -c 'o=$1; e=$2; shift 2; exec "$@" >"$o" 2>"$e"' _ "$out" "$SPIN_ERR" "$@"
  local rc=$?
  echo_restore
  tty_flush
  return $rc
}

# The daemon is listening on the same microphone. Saying the wake phrase
# twenty-five times at it would fire twenty-five wake events and twenty-five
# agent calls, so it is paused for the duration and restored on every exit
# path, including Ctrl-C.
DAEMON_WAS_RUNNING=0
pause_daemon() {
  if systemctl --user is-active --quiet agentvoice.service; then
    DAEMON_WAS_RUNNING=1
    gum style --foreground 4 "  Pausing the listener so it does not hear you practising."
    systemctl --user stop agentvoice.service
  fi
}
resume_daemon() {
  if (( DAEMON_WAS_RUNNING )); then
    systemctl --user start agentvoice.service 2>/dev/null || true
    DAEMON_WAS_RUNNING=0
  fi
}

# A new verifier is only picked up when the engine is rebuilt. Reusing existing
# recordings skips the recording phase entirely, so nothing ever paused the
# daemon and nothing ever restarted it -- leaving it running the verifier it
# loaded at startup while the freshly trained one sat unused on disk.
restart_daemon() {
  if systemctl --user is-active --quiet agentvoice.service; then
    systemctl --user restart agentvoice.service 2>/dev/null || true
  else
    resume_daemon
  fi
}

# If gum is killed mid-prompt it can leave foot's kitty keyboard protocol
# pushed, and every later keypress arrives as a literal escape sequence. Pop
# it and turn bracketed paste back off on the way out. Popping an empty stack
# is a no-op, so this is safe even when gum cleaned up after itself.
kbd_restore() { { printf '\e[<u\e[?2004l' >/dev/tty; } 2>/dev/null || true; }

# Every gum invocation asks the terminal whether it speaks the kitty keyboard
# protocol (CSI ? u). foot answers on the *input* stream with CSI ? 1 u. If gum
# has already exited by the time that answer arrives -- which it has, for a
# prompt the user dismissed quickly -- the reply sits in the input buffer and
# the shell echoes it as text. That is the ^[[?1u appearing beside the spinner,
# and the ^[[99;133u was a key report arriving the same way.
#
# Draining the reply after every gum call is the cure. Wrapping the name means
# no call site has to remember.
tty_flush() { { read -rsn 256 -t 0.06 </dev/tty; } >/dev/null 2>&1 || true; }
gum() { command gum "$@"; local rc=$?; tty_flush; return $rc; }

# Belt and braces, because the drain above depends on winning a race with the
# terminal's reply. With echo off, a reply that arrives late is never printed
# whether or not anything reads it. gum turns echo off for its own prompts and
# restores it after, so this is reapplied around the slow phases rather than
# set once.
TTY_STATE=""
echo_off() {
  [[ -c /dev/tty ]] || return 0
  TTY_STATE="$(stty -g </dev/tty 2>/dev/null)" || return 0
  stty -echo </dev/tty 2>/dev/null || true
}
echo_restore() {
  [[ -n ${TTY_STATE:-} ]] || return 0
  stty "$TTY_STATE" </dev/tty 2>/dev/null || true
  TTY_STATE=""
}

cancelled() {
  echo
  resume_daemon
  kbd_restore
  gum style --foreground 3 "  Cancelled. Nothing was saved."
  exit 130
}
trap cancelled INT TERM
trap 'resume_daemon; echo_restore; kbd_restore' EXIT

find_python() {
  local candidates=(
    "${AGENTVOICE_PYTHON:-}"
    "$STATE/venv/bin/python"          # installed
    "$REPO/bench/.venv/bin/python"    # development checkout
  )
  for p in "${candidates[@]}"; do
    [[ -n $p && -x $p ]] && { echo "$p"; return 0; }
  done
  return 1
}

PY="$(find_python)" || {
  gum style --foreground 1 "  No agentvoice Python environment found."
  echo "  Run the installer first, or set AGENTVOICE_PYTHON."
  exit 1
}
VERIFIER="$REPO/daemon/verifier.py"

# --- why we are here ------------------------------------------------------
gum style --border rounded --padding "0 2" --margin "1 0" \
  --border-foreground 4 --width "$W" \
  "Train a personal wake word verifier" \
  "" \
  "$(printf '%s' "Wake word models are speaker independent, so a podcast or a phone saying the phrase wakes them too. This trains a small classifier on your voice, to tell you from them." | wrap)" \
  "" \
  "$(printf '%s' "It runs only after the wake word already fired. ${CLIPS} recordings, about two minutes, and they stay on this machine." | wrap)"

if ! gum confirm "Train a verifier now?" --affirmative "Let's go" --negative "Not now"; then
  cancelled
fi

screen

# --- the verifier is only consulted by the openWakeWord engine -------------
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
current_engine() {
  [[ -r $SHELL_JSON ]] || { echo vosk; return; }
  jq -r '[.bar.layout[]?[]? | select(.id=="duaneoca.agentvoice")][0].engine // "vosk"' \
    "$SHELL_JSON" 2>/dev/null || echo vosk
}

if [[ "$(current_engine)" != "openwakeword" ]]; then
  echo
  gum style --foreground 3 \
    "  The wake word engine is currently Vosk, which has no model to attach a" \
    "  verifier to. Training will still work, but nothing will use the result" \
    "  until you switch."
  if gum confirm "Switch the engine to openWakeWord now?"; then
    omarchy bar set duaneoca.agentvoice engine openwakeword >/dev/null
    gum style --foreground 2 "  Switched."
  fi
fi

# --- other speakers, fetched if there are none -----------------------------
# A default install has one Piper voice, and one voice makes four contrast
# clips where training needs five -- so the stock install could not train a
# verifier at all. These are the other speakers, most contrasting first, and
# the URL is the same layout install.sh:fetch_voice uses; the check script
# asserts the two stay in step.
PIPER_BASE="https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US"
OTHER_SPEAKERS=(ryan-medium amy-medium joe-medium kristin-medium)

# Fetch one voice into the Piper directory. Both files or neither: a voice
# whose .json never arrived loads as a stack trace inside gum spin.
fetch_speaker() {
  local id="$1" dir="$2" name="${1%-*}" quality="${1##*-}"
  local file="en_US-$id.onnx"
  [[ -f "$dir/$file" ]] && return 0
  local base="$PIPER_BASE/$name/$quality"
  local tmp; tmp="$(mktemp -d)"
  if curl -fsSL -o "$tmp/$file" "$base/$file" &&
     curl -fsSL -o "$tmp/$file.json" "$base/$file.json"; then
    mkdir -p "$dir"
    mv "$tmp/$file" "$tmp/$file.json" "$dir/"
    rm -rf "$tmp"
    return 0
  fi
  rm -rf "$tmp"
  return 1
}

# --- which wake model ------------------------------------------------------
MODEL="$("$PY" "$VERIFIER" models | gum choose --header "Which wake word are you training for?")" || cancelled
[[ -n $MODEL ]] || cancelled
SPOKEN="${MODEL//_/ }"

POS="$WORK/$MODEL/positives"
NEG="$WORK/$MODEL/negatives"
mkdir -p "$POS" "$NEG"

# --- is there already one? -------------------------------------------------
# Running this a second time used to walk silently past both the existing
# verifier and the clips already on disk, straight to retraining on the old
# recordings -- which looks like nothing happened.
EXISTING="$("$PY" "$VERIFIER" list 2>/dev/null | awk -v m="$MODEL" '$1 ~ "^"m {print $2; exit}')"
if [[ -n ${EXISTING:-} && -f $EXISTING ]]; then
  echo
  gum style --foreground 3 \
    "  A verifier for $MODEL already exists, trained $(date -r "$EXISTING" '+%-d %b at %H:%M')."
  if ! gum confirm "Replace it?" --affirmative "Replace" --negative "Keep it"; then
    gum style --foreground 4 "  Keeping the existing one. Nothing changed."
    exit 130
  fi
fi

HAVE_POS=$(find "$POS" -name '*.wav' 2>/dev/null | wc -l)
REUSE=0
if (( HAVE_POS >= 10 )); then
  echo
  printf '%s\n' "There are already $HAVE_POS recordings of you saying this phrase from a previous run." | wrapw
  if gum confirm "Reuse them?" --affirmative "Reuse" --negative "Record fresh"; then
    REUSE=1
  else
    rm -f "$POS"/*.wav
  fi
fi

# --- negatives: reuse anything already recorded ---------------------------
NEG_COUNT="$("$PY" "$VERIFIER" negatives "$NEG" --from "${AGENTVOICE_NEGATIVES:-$REPO/bench/corpus/wav}" 2>/dev/null || echo 0)"

# The failure we actually care about is a phone or podcast saying the phrase in
# someone else's voice. Negatives made only of miscellaneous speech teach
# "phrase versus no phrase", which the base model already knows. Other voices
# saying the phrase teach "right words, wrong speaker" -- and the Piper voices
# already on disk for TTS are exactly that, for free.
OTHERS_FILE="$(mktemp)"
spin "Synthesising other voices saying \"$SPOKEN\" — about 9s" "$OTHERS_FILE" -- \
  "$PY" "$VERIFIER" synth-negatives "$SPOKEN" "$NEG" || true
OTHERS="$(tr -dc '0-9' < "$OTHERS_FILE")"; rm -f "$OTHERS_FILE" "${SPIN_ERR:-}"
OTHERS="${OTHERS:-0}"

# Count the directory, not the two steps' arithmetic. gather_negatives counts
# the clips already in there, and synth-negatives writes deterministic
# filenames -- so on a second run it re-made the same four clips, both steps
# reported four, and the gate let eight through when four existed. train()
# then failed on the real count, after twenty-five positives had been
# recorded. A gate that lies costs more than one that refuses.
NEG_COUNT=$(find "$NEG" -name '*.wav' 2>/dev/null | wc -l)

# Not enough to contrast against, because there is only one speaker to
# synthesise from. Offer the other speakers rather than refusing: a verifier
# trained against one voice's own parameter jitter is not what this is for.
if (( NEG_COUNT < 5 )); then
  VOICES_DIR="$("$PY" "$VERIFIER" voices --path 2>/dev/null)"
  WANT=()
  for id in "${OTHER_SPEAKERS[@]}"; do
    [[ -f "$VOICES_DIR/en_US-$id.onnx" ]] || WANT+=("$id")
    (( ${#WANT[@]} >= 2 )) && break
  done

  if (( ${#WANT[@]} > 0 )) && command -v curl >/dev/null 2>&1; then
    echo
    printf '%s\n' "The contrast clips are other people saying \"$SPOKEN\", so the verifier learns \"right words, wrong speaker\". You have one voice on disk, which is not enough to contrast against." | wrapw
    echo
    if gum confirm "Fetch ${#WANT[@]} more voices (${#WANT[@]}x60MB) to contrast against?" \
         --affirmative "Fetch them" --negative "Not now"; then
      for id in "${WANT[@]}"; do
        FETCH_OUT="$(mktemp)"
        if spin "Downloading the voice $id — 60MB" "$FETCH_OUT" -- fetch_speaker "$id" "$VOICES_DIR"; then
          gum style --foreground 2 "  Fetched $id."
        else
          gum style --foreground 3 "  Could not fetch $id; carrying on with what is here."
        fi
        rm -f "$FETCH_OUT" "${SPIN_ERR:-}"
      done
      OTHERS_FILE="$(mktemp)"
      spin "Synthesising the new voices saying \"$SPOKEN\"" "$OTHERS_FILE" -- \
        "$PY" "$VERIFIER" synth-negatives "$SPOKEN" "$NEG" || true
      OTHERS="$(tr -dc '0-9' < "$OTHERS_FILE")"; rm -f "$OTHERS_FILE" "${SPIN_ERR:-}"
      OTHERS="${OTHERS:-0}"
      NEG_COUNT=$(find "$NEG" -name '*.wav' 2>/dev/null | wc -l)
    fi
  fi
fi

if (( NEG_COUNT >= 5 )); then
  gum style --foreground 2 \
    "  Contrast set: $NEG_COUNT clips ($OTHERS of other voices saying the phrase)."
else
  # This message used to send people to `python bench/record.py`, which is not
  # installed -- bench/ stays in the checkout -- and to describe the wrong
  # clips: recordings of you *not* saying the phrase teach "phrase versus no
  # phrase", which the base model already knows. What is missing is other
  # speakers saying it.
  VOICES_ON_DISK="$("$PY" "$VERIFIER" voices 2>/dev/null || echo 0)"
  gum style --foreground 3 "  Only $NEG_COUNT contrast clips — training needs 5."
  [[ $VOICES_ON_DISK == 1 ]] && VOICE_WORD="voice" || VOICE_WORD="voices"
  printf '%s\n' "The contrast clips are other voices saying \"$SPOKEN\", synthesised from the Piper voices on disk. You have $VOICES_ON_DISK $VOICE_WORD, giving $NEG_COUNT clips — one speaker, so there is nothing yet to contrast your voice against." | wrapw
  echo
  printf '%s\n' "Run this again and accept the download, or add a voice yourself: pick a different one under Voice in the Agent Voice settings and re-run the installer, which fetches what the settings ask for and keeps the one you had." | wrapw
  echo
  gum style --foreground 4 "    ~/.config/omarchy/plugins/duaneoca.agentvoice/install.sh"
  echo
  if (( HAVE_POS > 0 )); then
    echo
    printf '%s\n' "Your $HAVE_POS recordings are kept, so this picks up where it left off." | wrapw
  fi
  exit 1
fi

# --- positives -------------------------------------------------------------
if (( REUSE )); then
  have=$HAVE_POS
else
pause_daemon
screen
gum style --foreground 4 --bold "  Recording $CLIPS samples"
echo
printf '%s\n' "Say \"$SPOKEN\" the way you actually would: same distance, ordinary voice. Vary it a little -- some faster, some quieter, some as if mid-sentence." | wrapw
echo

have=$(find "$POS" -name '*.wav' | wc -l)
attempt=0
# Everything that reads a key goes through gum. Mixing bubbletea prompts with
# bash's `read` leaves foot's kitty keyboard protocol enabled for the read,
# which then receives raw key reports and prints them as text -- the stray
# ^[[99;133u and ^[[?1u around the output. One input library, no leakage.
while (( have < CLIPS )); do
  (( attempt++ ))
  if ! gum confirm "  [$((have + 1))/$CLIPS]  ready?" \
       --affirmative "Record" --negative "Stop here"; then
    break
  fi

  printf '   \033[31m● recording\033[0m %.1fs ... ' "$CLIP_SECONDS"
  out="$("$PY" "$VERIFIER" record "$POS/pos-$(printf '%03d' "$attempt").wav" \
        --seconds "$CLIP_SECONDS" 2>/dev/null)"
  status=$?
  level="$(head -1 <<<"$out")"
  problem="$(tail -n +2 <<<"$out")"

  if (( status != 0 )); then
    printf '\033[33m%s\033[0m\n' "$problem"
    continue
  fi
  printf '\033[32mok\033[0m  (%s dBFS)\n' "$level"
  have=$(find "$POS" -name '*.wav' | wc -l)
done

fi

if (( have < 10 )); then
  gum style --foreground 1 "  Only $have clips. Need at least 10 to train anything useful."
  cancelled
fi

# --- train -----------------------------------------------------------------
screen
echo
OUT_FILE="$(mktemp)"
if ! spin "Training on $have clips of your voice" "$OUT_FILE" -- \
     "$PY" "$VERIFIER" train "$MODEL" "$POS" "$NEG"; then
  rm -f "$OUT_FILE"
  gum style --foreground 1 "  Training failed."
  [[ -s ${SPIN_ERR:-} ]] && tail -3 "$SPIN_ERR" | sed 's/^/  /'
  rm -f "${SPIN_ERR:-}"
  exit 1
fi
OUT="$(tail -1 "$OUT_FILE")"; rm -f "$OUT_FILE" "${SPIN_ERR:-}"

# --- a threshold this model can actually reach ------------------------------
# openWakeWord's default of 90 suits the four pretrained phrases, which peak
# near 0.996. A locally trained one does not: measured on twenty-five real
# recordings, this model peaked at a median of 0.775 with its verifier, so at
# 90 not one of them would have woken it. It never fired, nothing said so, and
# the symptom was an indicator light that never came on. The clips are right
# here, so measure instead of leaving the default to be wrong quietly.
SUGGEST_FILE="$(mktemp)"
if spin "Measuring what this model scores on your voice" "$SUGGEST_FILE" --      "$PY" "$VERIFIER" suggest-threshold "$MODEL" "$POS"; then
  read -r WANT_PCT HITS TOTAL USABLE < "$SUGGEST_FILE"
fi
rm -f "$SUGGEST_FILE" "${SPIN_ERR:-}"

# `omarchy bar` has set but no get, so read the value the way install.sh does.
NOW_PCT="$(jq -r '[.bar.layout[]?[]? | select(.id=="duaneoca.agentvoice")][0].owwThresholdPct // empty' \
  "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json" 2>/dev/null)"
[[ -n ${NOW_PCT//[^0-9]/} ]] || NOW_PCT=90

if [[ -n ${WANT_PCT:-} ]] && (( WANT_PCT != NOW_PCT )); then
  echo
  printf '%s\n' "The wake threshold is $NOW_PCT%. Measured against your $TOTAL recordings, $WANT_PCT% catches $HITS of them; $USABLE registered with this model at all." | wrapw
  echo
  if gum confirm "Set the wake threshold to $WANT_PCT%?" \
       --affirmative "Set it" --negative "Leave it at $NOW_PCT%"; then
    # --json, because it feeds `jq --argjson`: without it the number is stored
    # as the string "63" while every other numeric setting is a number. The UI's
    # persist() passes it for exactly this reason. A bare string must omit it,
    # which is why `engine openwakeword` above does.
    omarchy bar set duaneoca.agentvoice owwThresholdPct "$WANT_PCT" --json >/dev/null 2>&1 &&
      gum style --foreground 2 "  Wake threshold set to $WANT_PCT%." ||
      gum style --foreground 3 "  Could not write the setting; set it in Settings."
  fi
  if (( USABLE * 2 < TOTAL )); then
    printf '%s\n' "Fewer than half your recordings registered at all, which usually means the phrase was clipped by the recording window rather than that the threshold is wrong." | wrapw
  fi
fi

restart_daemon

echo
gum style --border rounded --padding "0 2" --border-foreground 2 --width "$W" \
  "Verifier trained" \
  "" \
  "model   $MODEL" \
  "clips   $have yours / $NEG_COUNT contrast" \
  "saved   $(basename "$OUT")" \
  "        in ~/.local/share/agentvoice/verifiers/"
echo
printf '%s\n' "It is live now. If the wake word stops responding entirely, the verifier is the first suspect -- delete that file to fall back to the base model." | wrapw
