#!/bin/bash
# Train a personal wake-word verifier.
#
# Designed to run inside omarchy-launch-floating-terminal-with-presentation,
# which wraps it in the Omarchy logo/done screens and suppresses the "done"
# screen on exit 130. So every cancel path here exits 130 deliberately.

set -uo pipefail

CLIPS=25
CLIP_SECONDS=2.0
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/agentvoice"
WORK="$STATE/verifier-training"
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# The daemon is listening on the same microphone. Saying the wake phrase
# twenty-five times at it would fire twenty-five wake events and twenty-five
# agent calls, so it is paused for the duration and restored on every exit
# path, including Ctrl-C.
DAEMON_WAS_RUNNING=0
pause_daemon() {
  if systemctl --user is-active --quiet agentvoice.service; then
    DAEMON_WAS_RUNNING=1
    gum style --foreground 4 "  Pausing the listener so it does not hear you practising."
    systemctl --user stop agentvoice.service
  fi
}
resume_daemon() {
  if (( DAEMON_WAS_RUNNING )); then
    systemctl --user start agentvoice.service 2>/dev/null || true
    DAEMON_WAS_RUNNING=0
  fi
}

cancelled() {
  echo
  resume_daemon
  gum style --foreground 3 "  Cancelled. Nothing was saved."
  exit 130
}
trap cancelled INT TERM
trap resume_daemon EXIT

find_python() {
  local candidates=(
    "${AGENTVOICE_PYTHON:-}"
    "$STATE/venv/bin/python"          # installed
    "$REPO/bench/.venv/bin/python"    # development checkout
  )
  for p in "${candidates[@]}"; do
    [[ -n $p && -x $p ]] && { echo "$p"; return 0; }
  done
  return 1
}

PY="$(find_python)" || {
  gum style --foreground 1 "  No agentvoice Python environment found."
  echo "  Run the installer first, or set AGENTVOICE_PYTHON."
  exit 1
}
VERIFIER="$REPO/daemon/verifier.py"

# --- why we are here ------------------------------------------------------
gum style --border rounded --padding "0 2" --margin "1 0" \
  --border-foreground 4 --width "$W" \
  "Train a personal wake word verifier" \
  "" \
  "$(printf '%s' "Wake word models are speaker independent, so a podcast or a phone saying the phrase wakes them too. This trains a small classifier on your voice, to tell you from them." | wrap)" \
  "" \
  "$(printf '%s' "It runs only after the wake word already fired. ${CLIPS} recordings, about two minutes, and they stay on this machine." | wrap)"

if ! gum confirm "Train a verifier now?" --affirmative "Let's go" --negative "Not now"; then
  cancelled
fi

screen

# --- the verifier is only consulted by the openWakeWord engine -------------
SHELL_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
current_engine() {
  [[ -r $SHELL_JSON ]] || { echo vosk; return; }
  jq -r '[.bar.layout[]?[]? | select(.id=="duaneoca.agentvoice")][0].engine // "vosk"' \
    "$SHELL_JSON" 2>/dev/null || echo vosk
}

if [[ "$(current_engine)" != "openwakeword" ]]; then
  echo
  gum style --foreground 3 \
    "  The wake word engine is currently Vosk, which has no model to attach a" \
    "  verifier to. Training will still work, but nothing will use the result" \
    "  until you switch."
  if gum confirm "Switch the engine to openWakeWord now?"; then
    omarchy bar set duaneoca.agentvoice engine openwakeword >/dev/null
    gum style --foreground 2 "  Switched."
  fi
fi

# --- which wake model ------------------------------------------------------
MODEL="$("$PY" "$VERIFIER" models | gum choose --header "Which wake word are you training for?")" || cancelled
[[ -n $MODEL ]] || cancelled
SPOKEN="${MODEL//_/ }"

POS="$WORK/$MODEL/positives"
NEG="$WORK/$MODEL/negatives"
mkdir -p "$POS" "$NEG"

# --- negatives: reuse anything already recorded ---------------------------
NEG_COUNT="$("$PY" "$VERIFIER" negatives "$NEG" --from "${AGENTVOICE_NEGATIVES:-$REPO/bench/corpus/wav}" 2>/dev/null || echo 0)"

# The failure we actually care about is a phone or podcast saying the phrase in
# someone else's voice. Negatives made only of miscellaneous speech teach
# "phrase versus no phrase", which the base model already knows. Other voices
# saying the phrase teach "right words, wrong speaker" -- and the Piper voices
# already on disk for TTS are exactly that, for free.
OTHERS="$(gum spin --show-output --title "Synthesizing other voices saying \"$SPOKEN\"..." -- \
         "$PY" "$VERIFIER" synth-negatives "$SPOKEN" "$NEG" 2>/dev/null || echo 0)"
NEG_COUNT=$(( NEG_COUNT + OTHERS ))

if (( NEG_COUNT >= 5 )); then
  gum style --foreground 2 \
    "  Contrast set: $NEG_COUNT clips ($OTHERS of other voices saying the phrase)."
else
  gum style --foreground 3 "  Only $NEG_COUNT contrast clips found."
  printf '%s\n' "Training needs recordings of you talking without the wake phrase, to contrast against. Run 'python bench/record.py' to build that corpus, then come back." | wrapw
  exit 1
fi

# --- positives -------------------------------------------------------------
pause_daemon
screen
gum style --foreground 4 --bold "  Recording $CLIPS samples"
echo
printf '%s\n' "Say \"$SPOKEN\" the way you actually would: same distance, ordinary voice. Vary it a little -- some faster, some quieter, some as if mid-sentence." | wrapw
echo

have=$(find "$POS" -name '*.wav' | wc -l)
attempt=0
while (( have < CLIPS )); do
  (( attempt++ ))
  printf '  [%2d/%2d] ' "$((have + 1))" "$CLIPS"
  read -r -p "Enter to record, or 'q' to stop: " key || cancelled
  [[ $key == q ]] && break

  printf '   \033[31m● recording\033[0m %.1fs ... ' "$CLIP_SECONDS"
  out="$("$PY" "$VERIFIER" record "$POS/pos-$(printf '%03d' "$attempt").wav" \
        --seconds "$CLIP_SECONDS" 2>/dev/null)"
  status=$?
  level="$(head -1 <<<"$out")"
  problem="$(tail -n +2 <<<"$out")"

  if (( status != 0 )); then
    printf '\033[33m%s\033[0m\n' "$problem"
    continue
  fi
  printf '\033[32mok\033[0m  (%s dBFS)\n' "$level"
  have=$(find "$POS" -name '*.wav' | wc -l)
done

if (( have < 10 )); then
  gum style --foreground 1 "  Only $have clips. Need at least 10 to train anything useful."
  cancelled
fi

# --- train -----------------------------------------------------------------
screen
echo
OUT="$(gum spin --show-output --title "Training on $have clips of your voice..." -- \
      "$PY" "$VERIFIER" train "$MODEL" "$POS" "$NEG")" || {
  gum style --foreground 1 "  Training failed."
  exit 1
}

resume_daemon

echo
gum style --border rounded --padding "0 2" --border-foreground 2 --width "$W" \
  "Verifier trained" \
  "" \
  "model   $MODEL" \
  "clips   $have yours / $NEG_COUNT contrast" \
  "saved   $(basename "$OUT")" \
  "        in ~/.local/share/agentvoice/verifiers/"
echo
printf '%s\n' "It is live now. If the wake word stops responding entirely, the verifier is the first suspect -- delete that file to fall back to the base model." | wrapw
