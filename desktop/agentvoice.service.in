# Template. install.sh substitutes @ROOT@ and @VENV@ and writes the result to
# ~/.config/systemd/user/agentvoice.service, so the unit carries the real path
# of whichever checkout or plugin directory it was installed from.
[Unit]
Description=Agent Voice — wake word, transcription, spoken replies
Documentation=https://github.com/duaneoca/agent-voice
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@VENV@/bin/python -u @ROOT@/daemon/wake_listen.py
Restart=on-failure
RestartSec=2
# Whisper on four older cores is the whole budget; niceness keeps a long
# transcription from making the desktop stutter.
Nice=5
# The state file the bar widget watches lives here.
RuntimeDirectory=agentvoice
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=graphical-session.target
