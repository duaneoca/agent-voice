# Template. install.sh substitutes @VENV@ and writes the result to
# $XDG_CONFIG_HOME/systemd/user/agentvoice.service, so the unit points at the
# virtualenv of whichever install it came from. @ROOT@ is deliberately not
# used for WorkingDirectory any more: install.sh deletes and recreates the
# app directory, which left the daemon with an unlinked cwd, and Piper's
# loader calls Path.cwd() -- so no new voice could ever load after an upgrade.
[Unit]
Description=Agent Voice — wake word, transcription, spoken replies
Documentation=https://github.com/duaneoca/agent-voice
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# %h, not the install directory. install.sh removes and recreates @ROOT@, so a
# daemon already running is left sitting in an unlinked inode -- and from then
# on anything that calls os.getcwd() fails with ENOENT. Piper's voice loader
# does, via Path.cwd(), so after any reinstall the running daemon could never
# load another voice: the one it had kept working, every new one raised
# "[Errno 2] No such file or directory" with nothing to say which file.
# Nothing here needs the install directory as its cwd; every adapter is handed
# one explicitly.
WorkingDirectory=%h
# Quoted: systemd splits ExecStart on whitespace, and both paths come from
# $HOME, which can legally contain a space.
ExecStart="@VENV@/bin/python" -u "@ROOT@/daemon/wake_listen.py"
Restart=on-failure
RestartSec=2
# Whisper is the whole CPU budget on an older machine; niceness keeps a long
# transcription from making the desktop stutter.
Nice=5
# The state file the bar widget watches lives here.
RuntimeDirectory=agentvoice
RuntimeDirectoryPreserve=yes

# Hardening, kept to what cannot get in the way. Everything here applies to
# the agent CLI too -- it is a child of this unit, in this cgroup -- and the
# agent exists to edit the user's files and run their commands on request. So
# ProtectHome=, ReadOnlyPaths= and PrivateTmp= are all out: they would break
# the purpose, or hide the agent's scratch files from the user looking for
# them.
#
# NoNewPrivileges= is out for the same reason and is worth naming: it would
# stop the agent running sudo or pkexec at all, so "install this package"
# would fail with a permission error rather than a password prompt. It is the
# obvious hardening line to add, and adding it would quietly remove a thing
# the user can currently ask for.
#
# These two restrict nothing a voice assistant or an agent legitimately does:
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
