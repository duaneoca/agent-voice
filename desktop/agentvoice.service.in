# Template. install.sh substitutes @ROOT@ and @VENV@ and writes the result to
# ~/.config/systemd/user/agentvoice.service, so the unit carries the real path
# of whichever checkout or plugin directory it was installed from.
[Unit]
Description=Agent Voice — wake word, transcription, spoken replies
Documentation=https://github.com/duaneoca/agent-voice
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# %h, not the install directory. install.sh removes and recreates @ROOT@, so a
# daemon already running is left sitting in an unlinked inode -- and from then
# on anything that calls os.getcwd() fails with ENOENT. Piper's voice loader
# does, via Path.cwd(), so after any reinstall the running daemon could never
# load another voice: the one it had kept working, every new one raised
# "[Errno 2] No such file or directory" with nothing to say which file.
# Nothing here needs the install directory as its cwd; every adapter is handed
# one explicitly.
WorkingDirectory=%h
ExecStart=@VENV@/bin/python -u @ROOT@/daemon/wake_listen.py
Restart=on-failure
RestartSec=2
# Whisper on four older cores is the whole budget; niceness keeps a long
# transcription from making the desktop stutter.
Nice=5
# The state file the bar widget watches lives here.
RuntimeDirectory=agentvoice
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=graphical-session.target
